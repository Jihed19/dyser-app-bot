rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil académico del estudiante aislado por UID del usuario autenticado
    match /student_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Datos personales de cada usuario (tareas académicas, sesiones de chat, metas diarias)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
